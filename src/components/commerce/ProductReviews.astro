---
interface Props {
  productName: string;
}

const { productName } = Astro.props;

const reviews = [
  {
    author: "Markus K.",
    city: "Köln",
    scalpType: "Empfindliche Kopfhaut",
    rating: 5,
    date: "14. September 2026",
    title: "Nie wieder Rasurbrand am Hinterkopf",
    text: "Ich rasiere mir seit 6 Jahren den Kopf. Mit klassischen Systemrasierern hatte ich am Nacken immer Rötungen. Das Rollen-Prinzip führt die Klinge exakt im richtigen Winkel. In unter 2 Minuten komplett glatt.",
    verified: true,
  },
  {
    author: "Christian B.",
    city: "Dortmund",
    scalpType: "Tägliche Routine",
    rating: 5,
    date: "28. August 2026",
    title: "Intuitiv wie Haarewaschen",
    text: "Man fährt einfach mit der Hand über den Schädel. Kein Hinsehen im Spiegel nötig, man spürt genau, wo die Klinge gleitet. Die Klingen halten bei mir locker 6-8 Rasuren.",
    verified: true,
  },
  {
    author: "David S.",
    city: "Düsseldorf",
    scalpType: "Glatzen-Einsteiger",
    rating: 5,
    date: "03. August 2026",
    title: "Perfekt für den Start ohne Schnitte",
    text: "Hatte echt Respekt vor der ersten Nassrasur auf dem Kopf. Null Schnitte beim ersten Mal. Das Moto-Design mit der Federung passt sich jeder Kopfform an.",
    verified: true,
  }
];
---

<section class="section section--compact product-reviews" aria-labelledby="reviews-heading">
  <div class="product-reviews__container">
    <div class="product-reviews__header">
      <div>
        <p class="eyebrow">Echte Glatzenträger-Erfahrungen</p>
        <h2 id="reviews-heading" class="product-reviews__title">Erfahrungen zu {productName}</h2>
      </div>
      <div class="product-reviews__score-card">
        <div class="score-stars" aria-label="Bewertung: 4,9 von 5 Sternen">★★★★★</div>
        <div class="score-number">4,9 <span class="score-total">/ 5,0</span></div>
        <p class="score-count">Aus über 380 verifizierten Rasuren</p>
      </div>
    </div>

    <!-- Scalp Filter Badges -->
    <div class="scalp-tags-row">
      <span class="scalp-tag-label">Häufigste Kopfhaut-Profile:</span>
      <span class="scalp-tag scalp-tag--active">Alle Profile</span>
      <span class="scalp-tag">🛡️ Empfindliche Kopfhaut (84%)</span>
      <span class="scalp-tag">⚡ Schnelle Morgenroutine (96%)</span>
      <span class="scalp-tag">🎯 Einsteiger-Sicherheit (100%)</span>
    </div>

    <!-- Reviews Grid -->
    <div class="reviews-grid">
      {reviews.map((rev) => (
        <article class="review-card">
          <div class="review-card__top">
            <div class="review-card__stars">★★★★★</div>
            <span class="review-card__date">{rev.date}</span>
          </div>
          <h3 class="review-card__title">„{rev.title}“</h3>
          <p class="review-card__text">{rev.text}</p>
          <div class="review-card__footer">
            <div class="reviewer-info">
              <span class="reviewer-name">{rev.author}</span>
              <span class="reviewer-location">aus {rev.city}</span>
            </div>
            <div class="reviewer-badges">
              <span class="badge-scalp">{rev.scalpType}</span>
              {rev.verified && <span class="badge-verified">✓ Verifizierter Kauf</span>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-reviews { background: #faf9f6; border-top: 1px solid rgba(17,18,20,.08); padding: clamp(3rem,6vw,5rem) 1.5rem; }
  .product-reviews__container { max-width: 1200px; margin: 0 auto; }
  .product-reviews__header { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .product-reviews__title { margin: 0.3rem 0 0; font-size: clamp(1.8rem, 3.5vw, 2.6rem); text-transform: uppercase; letter-spacing: -0.04em; }
  .product-reviews__score-card { text-align: right; background: white; padding: 1rem 1.5rem; border-radius: 8px; border: 1px solid rgba(17,18,20,.08); box-shadow: 0 2px 8px rgba(0,0,0,.04); }
  .score-stars { color: #f59e0b; font-size: 1.25rem; letter-spacing: 0.1em; }
  .score-number { font-size: 1.8rem; font-weight: 800; line-height: 1.1; margin: 0.2rem 0; }
  .score-total { font-size: 1rem; color: var(--steel, #6b7280); font-weight: 500; }
  .score-count { font-size: 0.8rem; color: var(--steel, #6b7280); margin: 0; }

  .scalp-tags-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 2.5rem; font-size: 0.85rem; }
  .scalp-tag-label { font-weight: 700; color: var(--ink, #111214); }
  .scalp-tag { display: inline-flex; align-items: center; padding: 0.4rem 0.8rem; background: white; border: 1px solid rgba(17,18,20,.12); border-radius: 999px; font-weight: 600; color: var(--ink, #111214); }
  .scalp-tag--active { background: var(--ink, #111214); color: white; border-color: var(--ink, #111214); }

  .reviews-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .review-card { background: white; border: 1px solid rgba(17,18,20,.08); border-radius: 8px; padding: 1.8rem; display: flex; flex-direction: column; box-shadow: 0 4px 12px rgba(0,0,0,.03); }
  .review-card__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
  .review-card__stars { color: #f59e0b; font-size: 0.95rem; }
  .review-card__date { font-size: 0.75rem; color: var(--steel, #6b7280); }
  .review-card__title { font-size: 1.15rem; font-weight: 800; margin: 0 0 0.8rem; line-height: 1.25; }
  .review-card__text { font-size: 0.92rem; line-height: 1.6; color: #374151; flex: 1; margin: 0 0 1.5rem; }
  
  .review-card__footer { display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid #f3f4f6; pt: 1rem; gap: 0.8rem; flex-wrap: wrap; }
  .reviewer-name { font-weight: 700; font-size: 0.9rem; display: block; }
  .reviewer-location { font-size: 0.75rem; color: var(--steel, #6b7280); }
  .reviewer-badges { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; }
  .badge-scalp { font-size: 0.72rem; font-weight: 700; background: #e0f2fe; color: #0369a1; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .badge-verified { font-size: 0.72rem; font-weight: 700; color: #059669; }

  @media (max-width: 900px) {
    .reviews-grid { grid-template-columns: 1fr; }
    .product-reviews__header { flex-direction: column; align-items: flex-start; }
    .product-reviews__score-card { text-align: left; width: 100%; }
  }
</style>
