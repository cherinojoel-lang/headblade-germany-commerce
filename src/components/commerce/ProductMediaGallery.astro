---
import type { Product, ProductMedia } from "../../data/products";

interface Props { product: Product; }
const { product } = Astro.props;

const fallbackMedia: ProductMedia[] = [
  {
    src: product.detailImage ?? product.image,
    alt: `${product.name} – Hauptansicht`,
    kind: "product",
  },
  ...(product.secondaryImage
    ? [{ src: product.secondaryImage, alt: `${product.name} – weitere Produktansicht`, kind: "context" as const }]
    : []),
];
const sourceMedia = product.media?.length ? [...product.media] : fallbackMedia;
const media = sourceMedia.filter(
  (item, index, items) => items.findIndex((candidate) => candidate.src === item.src) === index,
);
---

<section class="product-gallery" aria-label={`Produktbilder zu ${product.name}`}>
  <div class:list={["product-gallery__stage", { "product-gallery__stage--multi": media.length > 1 }]}>
    {media.map((item, index) => (
      <figure id={`media-${product.slug}-${index + 1}`} class="product-gallery__figure">
        <img
          src={item.src}
          alt={item.alt}
          width="760"
          height="760"
          loading={index === 0 ? undefined : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          decoding="async"
          sizes="(max-width: 820px) 92vw, 44vw"
        />
      </figure>
    ))}
  </div>

  {media.length > 1 && (
    <nav class="product-gallery__thumbs" aria-label="Weitere Produktansichten">
      {media.map((item, index) => (
        <a href={`#media-${product.slug}-${index + 1}`} aria-label={`Produktansicht ${index + 1}: ${item.alt}`}>
          <img src={item.src} alt="" width="96" height="96" loading="lazy" decoding="async" />
        </a>
      ))}
    </nav>
  )}
</section>

<style>
  .product-gallery { min-width:0; background:linear-gradient(145deg,#e7e5df,#f8f7f3); padding:clamp(1.25rem,4vw,3.5rem); }
  .product-gallery__stage { display:grid; gap:1rem; }
  .product-gallery__stage--multi { grid-template-columns:1fr; }
  .product-gallery__figure { min-height:420px; display:grid; place-items:center; margin:0; scroll-margin-top:7rem; }
  .product-gallery__figure:not(:first-child) { min-height:320px; }
  .product-gallery__figure img { width:min(100%,660px); max-height:620px; object-fit:contain; filter:drop-shadow(0 26px 28px rgba(0,0,0,.18)); }
  .product-gallery__thumbs { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:1rem; }
  .product-gallery__thumbs a { display:grid; place-items:center; width:72px; height:72px; border:1px solid rgba(17,18,20,.18); background:white; }
  .product-gallery__thumbs img { width:64px; height:64px; object-fit:contain; }
  @media (max-width:820px) { .product-gallery__figure { min-height:340px; } }
</style>
