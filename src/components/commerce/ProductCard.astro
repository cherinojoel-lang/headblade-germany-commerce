---
import type { Product } from "../../data/products";
import { formatPrice } from "../../lib/catalog";
import { productHref, productImageAlt } from "../../lib/presentation";

interface Props { product: Product; }
const { product } = Astro.props;
---

<article class="product-card">
  <a class="product-card__media" href={productHref(product)}>
    {product.badge && <span class="product-card__badge">{product.badge}</span>}
    <img src={product.image} alt={productImageAlt(product)} width="500" height="500" loading="lazy" decoding="async" />
  </a>
  <div class="product-card__body">
    <h3><a href={productHref(product)}>{product.name}</a></h3>
    <p>{product.short}</p>
    <div class="product-card__price">
      <span>{formatPrice(product.price)}</span>
      {product.compareAtPrice && <del>{formatPrice(product.compareAtPrice)}</del>}
    </div>
    <a class="product-card__link" href={productHref(product)}>Details ansehen →</a>
  </div>
</article>
