---
import { site } from "../../data/site";
---

<footer class="site-footer">
  <div class="footer-brand">
    <strong>HeadBlade Germany</strong>
    <p>Öffentliche Design- und Funktionspreview. Produktion bleibt vollständig getrennt.</p>
  </div>
  <nav aria-label="Sortiment im Footer">
    <strong>Sortiment</strong>
    <a href="/rasierer">Rasierer</a>
    <a href="/klingen-zubehoer">Klingen &amp; Zubehör</a>
    <a href="/pflege">Pflege</a>
    <a href="/angebote">Angebote</a>
  </nav>
  <nav aria-label="Informationen im Footer">
    <strong>Informationen</strong>
    <a href="/finder">Produktfinder</a>
    <a href="/anleitungen">Anleitungen</a>
    <a href="/impressum">Impressum</a>
    <a href="/datenschutz">Datenschutz</a>
  </nav>
  <address>
    <strong>{site.legalName}</strong><br />
    {site.address.street}<br />
    {site.address.postalCode} {site.address.city}<br />
    <a href={`mailto:${site.email}`}>{site.email}</a><br />
    <a href={`tel:${site.phone.replace(/[^+\d]/g, "")}`}>{site.phone}</a>
  </address>
  <p class="footer-bottom">© 2026 HeadBlade Germany · Review-Preview · kein Checkout, kein Tracking</p>
</footer>
