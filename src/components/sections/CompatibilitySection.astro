---
import { getProduct } from "../../lib/catalog";
import { imageSize } from "../../lib/media";
interface Props { title?: string; }
const { title = "Welche Klinge brauchst du?" } = Astro.props;
const hb4 = getProduct("klingenset-4blade")!;
const hb6 = getProduct("klingenset-6blade")!;
const hb4Size = imageSize(hb4.image);
const hb6Size = imageSize(hb6.image);
---
<section class="section section--dark motion-blades" aria-labelledby="compat-title">
  <div class="section-heading">
    <p class="eyebrow">Kompatibilität zuerst</p>
    <h2 id="compat-title">{title}</h2>
    <p>Bevor du über Klingenzahl oder Vorrat nachdenkst, muss das System zu deinem HeadBlade passen. Deshalb steht die Kompatibilität hier vor dem Verkaufsargument.</p>
  </div>
  <div class="motion-blades__grid">
    <article class="motion-blade">
      <div class="motion-blade__media"><img src={hb4.image} alt="HeadBlade HB4 Klingenpackung" width={hb4Size.width} height={hb4Size.height} loading="lazy" decoding="async" /></div>
      <div><p class="eyebrow">HB4</p><h3>4-Blade-System</h3><p>{hb4.compatibility}</p><a class="button button--ghost" href="/vergleich/hb4-vs-hb6">HB4 mit HB6 vergleichen</a></div>
    </article>
    <article class="motion-blade">
      <div class="motion-blade__media"><img src={hb6.image} alt="HeadBlade HB6 Klingenpackung" width={hb6Size.width} height={hb6Size.height} loading="lazy" decoding="async" /></div>
      <div><p class="eyebrow">HB6</p><h3>6-Blade-System</h3><p>{hb6.compatibility}</p><a class="button button--ghost" href="/klingen-zubehoer">Klingenübersicht öffnen</a></div>
    </article>
  </div>
</section>
