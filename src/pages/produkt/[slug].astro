---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro";
import ProductHero from "../../components/commerce/ProductHero.astro";
import CompatibilityCard from "../../components/commerce/CompatibilityCard.astro";
import RelatedProducts from "../../components/commerce/RelatedProducts.astro";
import { products, type Product } from "../../data/products";
import { buildBreadcrumbJsonLd } from "../../lib/schema";
import { buildProductJsonLd } from "../../lib/schema";
import { primaryProductCategory, productRoute } from "../../lib/routes";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props { product: Product; }
const { product } = Astro.props as Props;
const reviewLabel = "Review-Preview: Checkout bewusst deaktiviert";
const related = products
  .filter((candidate) => candidate.slug !== product.slug && candidate.categories.some((category) => product.categories.includes(category)))
  .slice(0, 4);
const primaryCategory = primaryProductCategory(product);
const breadcrumbItems = [
  { name: "Startseite", path: "/" },
  primaryCategory
    ? { name: primaryCategory.name, path: primaryCategory.path }
    : { name: "Produkte", path: "/produkte" },
  { name: product.name, path: productRoute(product) },
] as const;
const jsonLd = [
  buildProductJsonLd(product),
  buildBreadcrumbJsonLd(breadcrumbItems),
];
---

<BaseLayout title={product.name} description={product.short} image={product.detailImage ?? product.image} {jsonLd}>
  <div class="section section--compact breadcrumb-shell">
    <Breadcrumbs items={breadcrumbItems} />
  </div>
  <ProductHero {product} {reviewLabel} />
  <section class="section section--compact">
    <CompatibilityCard {product} />
  </section>
  <RelatedProducts products={related} />
</BaseLayout>
